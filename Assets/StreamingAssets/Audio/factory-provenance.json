      "sha256": "7306b8e08e90dcfdf7b1bc1a467a542898937663b7a247c50149ff0aee26bf56"
    },
    {
      "cue": "NLD.lose",
      "language": "en",
      "caption_language": "ko",
      "text": "That was no error. I have more to observe.",
      "caption": "오류가 아니었네요. 더 관찰해야겠어요.",
      "voice": "slt",
      "file": "NLD_lose_v2.wav",
      "sha256": "26b6065d2a67770420a703f7c2ccd696412f565864c5afe98baf3a8bd39bb2eb"
    },
    {
      "cue": "BRA.ready",
      "language": "en",
      "caption_language": "ko",
      "text": "Let me hear your beat first.",
      "caption": "네 박자부터 들려줘.",
      "voice": "rms",
      "file": "BRA_ready_v2.wav",
      "sha256": "a6ed51a4a7e7908d8292fa5d5db2a431544052c568fcadab9d4041e264e64607"
    },
    {
      "cue": "BRA.skill",
      "language": "en",
      "caption_language": "ko",
      "text": "Leave a beat. Let it flow!",
      "caption": "한 박자 비우고, 흘려보내!",
      "voice": "rms",
      "file": "BRA_skill_v2.wav",
      "sha256": "8a8da775a745ac0b5560d0842e8d586d7281346b1de6be174544250cdc9f12f8"
    },
    {
      "cue": "BRA.win",
      "language": "en",
      "caption_language": "ko",
      "text": "Your rhythm made this rally sing.",
      "caption": "네 박자가 이 랠리를 노래하게 했어.",
      "voice": "rms",
      "file": "BRA_win_v2.wav",
      "sha256": "ec563c745f9345ede099e09b8d73cded3e5bfc78e066cafa0982e418bc45f1e4"
    },
    {
      "cue": "BRA.lose",
      "language": "en",
      "caption_language": "ko",
      "text": "I filled every silence. Next time, I listen.",
      "caption": "빈 박자를 다 채웠네. 다음엔 먼저 들을게.",
      "voice": "rms",
      "file": "BRA_lose_v2.wav",
      "sha256": "e217264d2baa1e0e299163cd9ee070eebf5c82dcde94e28039b22281ff7a374c"
    },
    {
      "cue": "MAR.ready",
      "language": "en",
      "caption_language": "ko",
      "text": "Look again. The path can change.",
      "caption": "다시 보자, 길은 바뀌니까.",
      "voice": "slt",
      "file": "MAR_ready_v2.wav",
      "sha256": "31ab56719a8e698ac71664e915d254401760cb2b57c85cb58bdd40f8fd565198"
    },
    {
      "cue": "MAR.skill",
      "language": "en",
      "caption_language": "ko",
      "text": "Read this moment, not the memory!",
      "caption": "기억 대신, 지금을 읽어!",
      "voice": "slt",
      "file": "MAR_skill_v2.wav",
      "sha256": "0a9a9855976fcd433edb4f21d2ac7813d020045799419d42eded044a8bb8a71b"
    },
    {
      "cue": "MAR.win",
      "language": "en",
      "caption_language": "ko",
      "text": "We made room for a different performance.",
      "caption": "다른 공연이 펼쳐질 자리를 만들었네요.",
      "voice": "slt",
      "file": "MAR_win_v2.wav",
      "sha256": "abb4477834a6994e9678640b1dade6bc2e9fd7eecdb97aa4db52f4a7e5f7e8a4"
    },
    {
      "cue": "MAR.lose",
      "language": "en",
      "caption_language": "ko",
      "text": "My old plan missed your new path.",
      "caption": "오래된 도면으로 새 길을 놓쳤네요.",
      "voice": "slt",
      "file": "MAR_lose_v2.wav",
      "sha256": "780bcb1bed741059484b1ea01347b6e4084459a56c9d168adcac453767b4868b"
    },
    {
      "cue": "ZAF.ready",
      "language": "en",
      "caption_language": "ko",
      "text": "I want to reach this horizon too.",
      "caption": "나도 이 길 끝에 가고 싶어.",
      "voice": "rms",
      "file": "ZAF_ready_v2.wav",
      "sha256": "1833dfa544cbf3ba4aa0a0a03aa337484e0a2ed2b45949fee8a186e92929fecf"
    },
    {
      "cue": "ZAF.skill",
      "language": "en",
      "caption_language": "ko",
      "text": "My next step. Our open horizon!",
      "caption": "내 다음 발걸음, 함께 열린 지평선!",
      "voice": "rms",
      "file": "ZAF_skill_v2.wav",
      "sha256": "34cdcba424f86e4e745fd56cc9d2d6bf68c1c2d340fa5b0d062ac879c13c549a"
    },
    {
      "cue": "ZAF.win",
      "language": "en",
      "caption_language": "ko",
      "text": "I reached my goal, and heard your steps.",
      "caption": "내 목표에 닿고, 네 발걸음도 들었어.",
      "voice": "rms",
      "file": "ZAF_win_v2.wav",
      "sha256": "3c40408ea292e4da08392b770ffcd43a95ccc198a73a215f9c82ebee106899dc"
    },
    {
      "cue": "ZAF.lose",
      "language": "en",
      "caption_language": "ko",
      "text": "I need a rest too. Then I will choose my path.",
      "caption": "나도 쉬어야겠어. 그런 다음 내 길을 고를게.",
      "voice": "rms",
      "file": "ZAF_lose_v2.wav",
      "sha256": "e71ef8984bf31f27a09fa155dcadd7508d00d1e4d66e64477f0605d7c8e6195a"
    }
  ],
